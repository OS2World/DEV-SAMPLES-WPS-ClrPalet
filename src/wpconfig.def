; wpconfig.def - REFERENCE ONLY - not fed to the build.
; wlib reads C:\OS2\DLL\wpconfig.dll directly to produce release\wpconfig.lib
; (wlib rejects EXPORTS .def files; it reads DLL export tables directly).
;
; Documents the three symbols consumed from wpconfig.dll.
; Per the toolkit IDLs, WPPalette and WPColorPalette ship in wpconfig.dll:
;   wppalet.idl:86   dllname = "wpconfig.dll";
;   wpclrpal.idl:34  dllname = "wpconfig.dll";

LIBRARY WPCONFIG
EXPORTS
   M_WPColorPaletteNewClass
   WPColorPaletteNewClass
   WPPaletteClassData
