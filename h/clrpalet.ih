SOMClass * SOMLINK M_ColorPaletteNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_M_ColorPalette && _somCheckVersion(_M_ColorPalette, somtmajorVersion, somtminorVersion))
          return _M_ColorPalette;
    M_WPColorPaletteNewClass(M_WPColorPalette_MajorVersion,M_WPColorPalette_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&M_ColorPaletteSCI, somtmajorVersion, somtminorVersion);
