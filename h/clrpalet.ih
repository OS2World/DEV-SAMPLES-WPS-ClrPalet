/*
 * Class Creation and Initialization
 */

SOMClass * SOMLINK ColorPaletteNewClass (integer4 somtmajorVersion,
		integer4 somtminorVersion)
{
    SOMClass *result;

    if (_ColorPalette && _somCheckVersion(_ColorPalette, somtmajorVersion, somtminorVersion))
          return _ColorPalette;
    WPColorPaletteNewClass(WPColorPalette_MajorVersion,WPColorPalette_MinorVersion);	/* static reference */
    /* Explicit metaclass, so get it */ 
    M_ColorPaletteNewClass(M_ColorPalette_MajorVersion,M_ColorPalette_MinorVersion);	/* static reference */
    result = somBuildClass(0xFFFFFFFF,&ColorPaletteSCI, somtmajorVersion, somtminorVersion);
    ColorPalette_parent_WPColorPalette_wpSelectCell_resolved = 
	somParentNumResolve(ColorPaletteCClassData.parentMtab, 1, WPPaletteClassData.wpSelectCell); 
    ColorPalette_parent_WPColorPalette_wpSetup_resolved = 
	somParentNumResolve(ColorPaletteCClassData.parentMtab, 1, WPObjectClassData.wpSetup); 
    ColorPalette_parent_WPColorPalette_wpRedrawCell_resolved = 
	somParentNumResolve(ColorPaletteCClassData.parentMtab, 1, WPPaletteClassData.wpRedrawCell); 
    ColorPalette_parent_WPColorPalette_wpEditCell_resolved = 
	somParentNumResolve(ColorPaletteCClassData.parentMtab, 1, WPPaletteClassData.wpEditCell); 
    ColorPalette_parent_WPColorPalette_wpPaintCell_resolved = 
	somParentNumResolve(ColorPaletteCClassData.parentMtab, 1, WPPaletteClassData.wpPaintCell); 
    return result;
}

