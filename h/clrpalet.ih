	somParentNumResolve(M_ColorPaletteCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryStyle); 
    M_ColorPalette_parent_M_WPColorPalette_wpclsQueryIconData_resolved = 
	somParentNumResolve(M_ColorPaletteCClassData.parentMtab, 1, M_WPObjectClassData.wpclsQueryIconData); 
    M_ColorPalette_parent_M_WPColorPalette_wpclsInitData_resolved = 
	somParentNumResolve(M_ColorPaletteCClassData.parentMtab, 1, M_WPObjectClassData.wpclsInitData); 
    return result;
